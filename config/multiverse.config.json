{
  "version": "0.1.0",
  "cluster": {
    "name": "multiverse-local",
    "apiUrl": "http://multiverse-api:8080",
    "registryUrl": "http://multiverse-api:8080/api/v1/nodes",
    "heartbeatSeconds": 30,
    "nodeTtlSeconds": 90
  },
  "services": {
    "api": { "host": "multiverse-api", "port": 8080 },
    "redis": { "host": "redis", "port": 6379 }
  },
  "node": {
    "role": "worker",
    "capabilities": ["docker", "vscode", "api"]
  }
}
