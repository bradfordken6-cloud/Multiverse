{
  "folders": [
    { "path": "." },
    { "path": "services/api" },
    { "path": "config" }
  ],
  "settings": {
    "files.exclude": {
      "**/__pycache__": true,
      "**/.venv": true,
      "**/.pytest_cache": true
    },
    "python.defaultInterpreterPath": "/usr/local/bin/python",
    "python.analysis.extraPaths": ["services/api"],
    "docker.composeFile": "${workspaceFolder}/docker-compose.yml"
  },
  "extensions": {
    "recommendations": [
      "ms-azuretools.vscode-docker",
      "ms-python.python",
      "ms-python.vscode-pylance"
    ]
  }
}
